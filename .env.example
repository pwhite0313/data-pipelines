# Copy this file to .env and fill in real values:
#   cp .env.example .env

OPENWEATHER_API_KEY=your_api_key_here
WAREHOUSE_USER=weather_user
WAREHOUSE_PASSWORD=weather_pass
WAREHOUSE_DB=weather_db
WAREHOUSE_HOST=postgres-warehouse
WAREHOUSE_PORT=5432

# Optional: override host-side ports if 8080/5432 are already taken locally.
# Internal service-to-service traffic is unaffected.
# AIRFLOW_WEBSERVER_PORT=8080
# WAREHOUSE_HOST_PORT=5432

# Set this to your host user's UID so files the containers create (logs, dbt
# artifacts, raw CSVs) are owned by you, not a fixed container UID:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
# AIRFLOW_UID=50000
